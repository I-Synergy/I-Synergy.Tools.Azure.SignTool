<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>I-Synergy.Tools.Azure.SignTool</PackageId>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>AzureSignTool</ToolCommandName>
    <AssemblyName>AzureSignTool</AssemblyName>
    <Description>I-Synergy Tools for Azure Sign Tool</Description>
    <PackageTags>I-Synergy, Tools, Azure, SignTool, Nuget, AzureSignTool, NugetAzureSignTool</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Security.KeyVault.Certificates" />
    <PackageReference Include="Azure.Security.KeyVault.Keys" />
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ISynergy.Tools.Azure.SignTool.Core\ISynergy.Tools.Azure.SignTool.Core.csproj" />
  </ItemGroup>
</Project>
